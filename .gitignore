# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/
.gem/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# _tex/ — LaTeX / LaTeXML source build artifacts (keep .tex, .bib, figures, .cls, etc.)
_tex/**/*.aux
_tex/**/*.log
_tex/**/*.out
_tex/**/*.toc
_tex/**/*.lof
_tex/**/*.lot
_tex/**/*.bbl
_tex/**/*.blg
_tex/**/*.fls
_tex/**/*.fdb_latexmk
_tex/**/*.synctex.gz
_tex/**/*.nav
_tex/**/*.snm
_tex/**/*.vrb
_tex/**/*.xdv
_tex/**/*.dvi
_tex/**/*.ilg
_tex/**/*.ind
_tex/**/*.idx
_tex/**/*.bcf
_tex/**/*.run.xml
_tex/**/*.pdf
_tex/**/*.latexml.log
_tex/**/*.latexml

# papers/ — LaTeXML HTML output (commit index.html, CSS, and extracted figures)
papers/**/LaTeXML.cache
papers/**/*.latexml.log
papers/**/*.latexml
# Safety net if pdflatex is run inside papers/ by mistake
papers/**/*.aux
papers/**/*.log
papers/**/*.out
papers/**/*.toc
papers/**/*.lof
papers/**/*.lot
papers/**/*.bbl
papers/**/*.blg
papers/**/*.fls
papers/**/*.fdb_latexmk
papers/**/*.synctex.gz
papers/**/*.nav
papers/**/*.snm
papers/**/*.vrb
papers/**/*.xdv
papers/**/*.ilg
papers/**/*.ind
papers/**/*.idx